! version = 2.0
! array skillswords = skills|skill|stack|technologies|tech stack|tech skills
! array eduwords = education degree graduation university college
! array langwords = languages language speak speaks
! array expwords = experience|work experience|employment|roles|positions|timeline|history
! array companies = mobiweb|red it|exact code sistemas|smart debrief|moomenti

// Shared yes/no/maybe word lists — reference via (@yeswords)/(@nowords)/
// (@maybewords) in any trigger that expects a plain positive, negative, or
// uncertain answer (e.g. the % (Previous) blocks in greetings.rive and
// cv.rive), instead of retyping the alternation each time.
! array yeswords = yes|yeah|yep|correct|thats right|that is right|right|seems good|sounds good|sure|ok|okay|alright|affirmative|roger|indeed
! array nowords = no|nope|not quite|thats not right|that is not right|wrong|nah|negative|never|not at all
! array maybewords = maybe|not sure|perhaps|possibly|i dont know|not certain|unsure
// Used in greetings.rive's confirm-name yeswords trigger to catch a
// nickname override tacked onto the confirmation itself, e.g. "yes, but
// you can call only Mary" instead of the full captured pendingname.
! array nicknamelead = call only|call me|just call me|but call me|you can call me|please call me|rather be called|prefer to be called

// Lead-in phrases for a one-word name given right after the bot asks for
// it (e.g. "call me Ana"). A separate array from nicknamelead above:
// that one is scoped to the yes+correction flow and adding "im"/"i
// am"/"it is" to it would risk false positives there (e.g. "yes im
// busy" reads as a yeswords+nicknamelead match). Kept in sync with the
// lead-in alternation in greetings.rive's main name-capture trigger.
! array namelead = my name is|it is|i am|im|you can call me|please call me|call me

// Off-topic/skeptical message handling (smalltalk.rive) — a hiring/fit
// question and a complaint about the bot itself are different enough in
// tone to need separate replies, so two arrays rather than one.
! array fitwords = good fit|hire wilson|should i hire|right for the job|right for this role|worth hiring|good hire
! array botcomplaintwords = annoying|useless|worthless|dumb bot|stupid bot|not helpful

> begin
  + request
  * <get met> == undefined => <set met=true> {topic=random} {ok}
  - {ok}
< begin

! var botname = Smart Assistant
! var locale = Portugal

! var cv_name = Wilson Souza de Medeiros Junior
! var cv_phone = +351 931-919-391
! var cv_email = wilsonmdrs@gmail.com
! var cv_linkedin = https://linkedin.com/in/wilson-medeiros-381711109
! var cv_location = Portugal
! var cv_summary = Wilson is a Software Engineer with extensive experience developing web and mobile applications — a motivated and adaptable team player with strong technical expertise, attention to detail, and a positive attitude.

! var cv_roles = Frontend Developer @ Smart Debrief (Nov 2025 - Present) | Senior Frontend Developer @ Moomenti (Sep 2025 - Nov 2025) | Senior Frontend Developer / App Manager @ Mobiweb (Jul 2023 - Aug 2025) | Frontend Developer @ Moomenti (Jun 2023) | Frontend Developer @ Red IT (Jul 2022 - Mar 2023) | Software Engineer @ Exact Code Sistemas (Oct 2019 - Mar 2022) | Software Developer (Freelancer) @ Exact Code Sistemas (Mar 2017 - Oct 2019)
! var cv_companies = Smart Debrief, Moomenti, Mobiweb, Red IT, and Exact Code Sistemas
! var cv_experience_years = 8
! var cv_education = Bachelor of Computer Science, Universidade do Sul de Santa Catarina, Brazil (Mar 2012 - Jun 2022)
! var cv_languages = Portuguese (native) and English (full professional proficiency)
! var cv_skills = JavaScript, TypeScript, React, React Native, Next.js, HTML5, CSS3, Styled Components, SASS, Node.js, Python, React Testing Library, Jest, Storybook, React Query, Tailwind, Figma, and Adobe XD

// botIntention values: centralized here so every trigger pulls from one
// source instead of retyping the phrase. Each value must read naturally
// inside the unknown.rive fallback: "still asking about <get botIntention>?"
//
// Key naming note: keys below (design, smartdebrief, redit, ...) must never
// contain an underscore. They travel through {@ setintent KEY} as matched
// trigger text, and RiveScript's message normalization strips underscores
// (and lowercases, and drops apostrophes) before matching — so "smart_debrief"
// would arrive as "smartdebrief" anyway. Keeping keys underscore-free avoids
// that silent mismatch. The intent_<key> var name itself is safe with an
// underscore since "intent_" is fixed literal text, not derived from input.
! var intent_summary = Wilson's background
! var intent_name = Wilson's name
! var intent_location = where Wilson is based
! var intent_contact = how to contact Wilson
! var intent_skills = Wilson's skills
! var intent_languages = the languages Wilson speaks
! var intent_education = Wilson's education
! var intent_experience = Wilson's work experience
// Follow-up to the experience reply's own trailing question ("Would you
// like to know more about a specific company or area...?") — the % blocks
// in cv.rive scoped to that question tag this on the yes/no reply itself,
// not via {@ setintent}, since it's a conversational-flow moment like
// askname/givename/confirmname, not a fresh development-topic answer.
! var intent_experiencefollowup = whether to hear about a specific company or area
// Same pattern, shared by all five company blurbs' trailing question.
! var intent_companyfollowup = what to ask about next
// Open-ended "tell me about Wilson" style prompt (topics.rive) — a real
// intent since the bot asks a follow-up question and needs its own
// unknownhint if the visitor's next reply doesn't match anything.
! var intent_wilsonoverview = what to know about wilson first
! var intent_wilsonoverviewfollowup = what to ask about next
! var intent_companies = the companies Wilson worked at
! var intent_smartdebrief = Wilson's experience at Smart Debrief
! var intent_moomenti = Wilson's experience at Moomenti
! var intent_redit = Wilson's experience at Red IT
! var intent_exactcode = Wilson's experience at Exact Code Sistemas
! var intent_mobiweb = Wilson's experience at Mobiweb
! var intent_frontend = Wilson's frontend experience
! var intent_mobile = Wilson's mobile development experience
! var intent_testing = Wilson's testing experience
! var intent_design = Wilson's design and UI experience
! var intent_backend = Wilson's backend experience
! var intent_ai = Wilson's AI-related experience
! var intent_leadership = Wilson's leadership experience
! var intent_tools = the tools Wilson uses
! var intent_careersummary = Wilson's career summary
! var intent_botidentity = what this assistant is
// Opening-phase intents, not development topics — tagged directly in
// greetings.rive (not via {@ setintent}, which would wrongly flip
// currentSession to "development" for what's still opening).
! var intent_askname = your name
! var intent_givename = what to ask about next
! var intent_confirmname = whether that is your name

// Per-intention custom hints for unknown.rive's FIRST miss, keyed the same
// way as intent_KEY above. MANDATORY: every intent_KEY must have a matching
// unknownhint_KEY — see the "must" note in the setintent comment below and
// the Authoring convention in Notion. Looked up dynamically via
// <bot unknownhint_<get userIntention>> — undefined (the literal string)
// means "no custom hint", which now only happens if this rule was missed;
// unknown.rive still falls back to the generic "still asking about
// <botIntention>?" template in that case, but treat that as a bug to fix,
// not a supported path. Can't nest <bot intent_KEY> inside these values to
// stay DRY — bot-var values aren't re-scanned for tags when substituted
// (confirmed: it prints the literal "<bot intent_x>" text) — so the phrase
// gets spelled out again here.
! var unknownhint_summary = Sorry, I did not quite get that. If you're asking about Wilson's background, try "who is wilson?"
! var unknownhint_name = Sorry, I did not quite get that. If you're asking for Wilson's full name, try "wilsons name?"
! var unknownhint_location = Sorry, I did not quite get that. If you're asking where Wilson is based, try "where do you live?"
! var unknownhint_contact = Sorry, I did not quite get that. If you're asking how to reach Wilson, try "contact details?"
! var unknownhint_skills = Sorry, I did not quite get that. If you're asking about Wilson's skills, try "what are your skills?"
! var unknownhint_languages = Sorry, I did not quite get that. If you're asking what languages Wilson speaks, try "what languages do you speak?"
! var unknownhint_education = Sorry, I did not quite get that. If you're asking about Wilson's education, try "what is your education?"
! var unknownhint_experience = Sorry, I did not quite get that. If you're asking about Wilson's work experience, try "what is your experience?"
! var unknownhint_experiencefollowup = Sorry, I did not quite get that. You can say yes or no, or just ask about a specific company like Moomenti or Smart Debrief.
! var unknownhint_companyfollowup = Sorry, I did not quite get that. You can say yes or no, or just ask about a specific company or skill area.
! var unknownhint_wilsonoverview = You can say things like "experience", "skills", "education", or a company name to start.
! var unknownhint_wilsonoverviewfollowup = Sorry, I did not quite get that. You can say yes or no, or just ask about a specific topic like skills or education.
! var unknownhint_companies = Sorry, I did not quite get that. If you're asking which companies Wilson worked at, try "which companies have you worked for?"
! var unknownhint_smartdebrief = Sorry, I did not quite get that. If you're asking about Wilson's time at Smart Debrief, try "tell me about smart debrief?"
! var unknownhint_moomenti = Sorry, I did not quite get that. If you're asking about Wilson's time at Moomenti, try "tell me about moomenti?"
! var unknownhint_redit = Sorry, I did not quite get that. If you're asking about Wilson's time at Red IT, try "tell me about red it?"
! var unknownhint_exactcode = Sorry, I did not quite get that. If you're asking about Wilson's time at Exact Code Sistemas, try "tell me about exact code sistemas?"
! var unknownhint_mobiweb = Sorry, I did not quite get that. If you're asking about Wilson's time at Mobiweb, try "tell me about mobiweb?"
! var unknownhint_frontend = Sorry, I did not quite get that. If you're asking about Wilson's frontend experience, try "tell me about your frontend experience?"
! var unknownhint_mobile = Sorry, I did not quite get that. If you're asking about Wilson's mobile development experience, try "tell me about mobile development?"
! var unknownhint_testing = Sorry, I did not quite get that. If you're asking about Wilson's testing experience, try "tell me about testing?"
! var unknownhint_design = Sorry, I did not quite get that. If you're asking about Wilson's design and UI experience, try "tell me about design?"
! var unknownhint_backend = Sorry, I did not quite get that. If you're asking about Wilson's backend experience, try "tell me about backend?"
! var unknownhint_ai = Sorry, I did not quite get that. If you're asking about Wilson's AI-related experience, try "tell me about ai?"
! var unknownhint_leadership = Sorry, I did not quite get that. If you're asking about Wilson's leadership experience, try "tell me about leadership?"
! var unknownhint_tools = Sorry, I did not quite get that. If you're asking about the tools Wilson uses, try "what tools do you use?"
! var unknownhint_careersummary = Sorry, I did not quite get that. If you're asking for Wilson's career summary, try "career summary?"
! var unknownhint_botidentity = Sorry, I did not quite get that. If you're asking who this assistant is, try "who are you?"
! var unknownhint_askname = Sorry, I did not quite get your name. You can try something like "My name is Ana".
! var unknownhint_givename = Sorry, I did not quite get that. You can ask about Wilson's summary, skills, education, or experience.
! var unknownhint_confirmname = Sorry, I did not quite get that. Please say yes or no, or tell me your name like "My name is Ana".

// currentSession mirrors Akira's Fluxograma: opening | development | closing.
// Set to "opening" once per session (see riveBot.ts startConversation()).
// Every development-topic trigger moves it to "development" via setintent
// below; greetings.rive's bye trigger moves it to "closing". There's no
// separate reset back to "opening" mid-session — a real conversation
// doesn't reset itself; a new one gets a fresh session id instead (see
// riveBot.ts). Read via <get currentSession> to gate opening-only content
// (see greetings.rive's greet trigger) the way Akira's Opening Rules
// checked currentSession before its repetition ladder.

// Centralized intention controller, mirroring Akira's ctrl<userIntention>
// pattern from the Fluxograma de Cadastro. Every trigger that cares about
// its own intention redirects here instead of setting/incrementing inline:
//   {@ setintent KEY}   — sets userIntention=KEY, botIntention=<bot intent_KEY>,
//                         currentSession=development, and clears unknownStreak
//   {@ ctrlintent KEY}  — increments a per-intention repeat counter (ctrl_KEY)
// The caller reads <get ctrl_KEY> in its own `*` conditional to decide
// whether this is a repeat ask and vary its reply — see cv.rive for the
// pattern. KEY must match one of the intent_KEY vars above (no underscores).
//
// MUST when registering a new intention: define BOTH intent_KEY (above) AND
// unknownhint_KEY (below) — never one without the other. intent_KEY without
// a matching unknownhint_KEY silently falls back to the generic "still
// asking about X?" template in unknown.rive, which is the pre-this-change
// behavior, not a deliberate choice — don't rely on it for new intentions.
//
// unknownStreak (see unknown.rive) counts consecutive unrecognized messages
// — reset here on any real match, per POP-AKR-003's Tratamento de
// Sentenças Desconhecidas. Akira scopes that counter per botIntention value
// (ctrlU<botIntention>); this KB uses one flat counter instead, since here
// the counter and botIntention only ever change at the same moments anyway
// — a per-topic key would behave identically without earning its
// complexity. Only setintent resets it, not every social trigger (hi,
// thanks, bye, compliment) — same asymmetry botIntention itself already
// has, kept for consistency rather than expanding scope further.
+ setintent *
- <set unknownStreak=0><set currentSession=development><set userIntention=<star>><set botIntention=<bot intent_<star>>>

+ ctrlintent *
- <add ctrl_<star>=1>

// Debug macro "logvars", registered from JS in riveBot.ts via
// bot.setSubroutine("logvars", ...) — not defined here, since RiveScript's
// own `> object ... < object` blocks only support Perl/Python in this
// engine's docs; setSubroutine is the JS-native equivalent. Console-logs
// session id, userIntention, botIntention, and the full uservar set for
// the current user. Called automatically after every reply in riveBot.ts;
// can also be dropped into any reply manually via <call>logvars <id></call>.

